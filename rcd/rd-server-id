#!/bin/sh

# PROVIDE: rd_server_rd_server_id
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf.local or /etc/rc.conf
# to enable this service:
#
# rd_server_rd_server_id_enable (bool):            Set to NO by default.
#               Set it to YES to enable rd_server_rd_server_id.
# rd_server_rd_server_id_ip (string):              Set IP address/hostname of relay server to use
#               Defaults to "127.0.0.1", please replace with your server hostname/IP.
# rd_server_rd_server_id_args (string):            Set extra arguments to pass to rd_server_rd_server_id
#               Default is "-r ${rd_server_rd_server_id_ip} -k _".
# rd_server_rd_server_id_user (string):            Set user that rd_server_rd_server_id will run under
#               Default is "root".
# rd_server_rd_server_id_group (string):           Set group that rd_server_rd_server_id will run under
#               Default is "wheel".

. /etc/rc.subr

name=rd_server_rd_server_id
desc="RD Server ID/Rendezvous Server"
rcvar=rd_server_rd_server_id_enable

load_rc_config $name

: ${rd_server_rd_server_id_enable:=NO}
: ${rd_server_rd_server_id_ip:=127.0.0.1}
: ${rd_server_rd_server_id_args="-r ${rd_server_rd_server_id_ip} -k _"}
: ${rd_server_rd_server_id_user:=rd_server}
: ${rd_server_rd_server_id_group:=rd_server}

pidfile=/var/run/rd_server_rd_server_id.pid
command=/usr/sbin/daemon
procname=/usr/local/sbin/rd_server_id
rd_server_rd_server_id_chdir=/var/db/rd_server
command_args="-p ${pidfile} -o /var/log/rd_server-rd_server_id.log ${procname} ${rd_server_rd_server_id_args}"
## If you want the daemon to do its log over syslog, comment out the above line and remove the comment from the below replacement
#command_args="-p ${pidfile} -T ${name} ${procname} ${rd_server_rd_server_id_args}"

start_precmd=rd_server_rd_server_id_startprecmd

rd_server_rd_server_id_startprecmd()
{
    if [ -e ${pidfile} ]; then
        chown ${rd_server_rd_server_id_user}:${rd_server_rd_server_id_group} ${pidfile};
    else
        install -o ${rd_server_rd_server_id_user} -g ${rd_server_rd_server_id_group} /dev/null ${pidfile};
    fi
    if [ -e ${rd_server_rd_server_id_chdir} ]; then
        chown -R ${rd_server_rd_server_id_user}:${rd_server_rd_server_id_group} ${rd_server_rd_server_id_chdir};
        chmod -R 770 ${rd_server_rd_server_id_chdir};
    else
        mkdir -m 770 ${rd_server_rd_server_id_chdir};
        chown ${rd_server_rd_server_id_user}:${rd_server_rd_server_id_group} ${rd_server_rd_server_id_chdir};
    fi
    if [ -e /var/log/rd_server-rd_server_id.log ]; then
        chown -R ${rd_server_rd_server_id_user}:${rd_server_rd_server_id_group} /var/log/rd_server-rd_server_id.log;
        chmod 660 /var/log/rd_server-rd_server_id.log;
    else
        install -o ${rd_server_rd_server_id_user} -g ${rd_server_rd_server_id_group} /dev/null /var/log/rd_server-rd_server_id.log;
        chmod 660 /var/log/rd_server-rd_server_id.log;
    fi
}

run_rc_command "$1"
