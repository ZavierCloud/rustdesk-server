
[Unit]
Description=RD Server ID/Rendezvous Server

[Service]
Type=simple
LimitNOFILE=1000000
ExecStart=/usr/bin/rd_server_id
WorkingDirectory=/var/lib/rd_server/
User=
Group=
Restart=always
StandardOutput=append:/var/log/rd_server/rd_server_id.log
StandardError=append:/var/log/rd_server/rd_server_id.error
# Restart service after 10 seconds if node service crashes
RestartSec=10

[Install]
WantedBy=multi-user.target

