
[Unit]
Description=RD Server Relay Server

[Service]
Type=simple
LimitNOFILE=1000000
ExecStart=/usr/bin/rd_server_relay
WorkingDirectory=/var/lib/rd_server/
User=
Group=
Restart=always
StandardOutput=append:/var/log/rd_server/rd_server_relay.log
StandardError=append:/var/log/rd_server/rd_server_relay.error
# Restart service after 10 seconds if node service crashes
RestartSec=10

[Install]
WantedBy=multi-user.target

